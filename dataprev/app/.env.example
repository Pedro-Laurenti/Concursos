# Copie este arquivo para .env e preencha com seus valores.
# O arquivo .env NÃO deve ser commitado (adicione ao .gitignore).

# Connection string do Azure Storage Account (tabelas do app)
# Encontre em: Azure Portal > Storage Account > Access keys > Connection string
AzureWebJobsStorage=DefaultEndpointsProtocol=https;AccountName=SEU_ACCOUNT;AccountKey=SUA_KEY;EndpointSuffix=core.windows.net

# Para dev local com Azurite (emulador gratuito):
# AzureWebJobsStorage=UseDevelopmentStorage=true

# Porta local (padrão: 8000)
# PORT=8000
